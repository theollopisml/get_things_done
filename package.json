{
	"name": "get-things-done",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check src vite.config.ts drizzle.config.ts eslint.config.js prettier.config.js package.json tsconfig.json pnpm-workspace.yaml && eslint .",
		"format": "prettier --write src vite.config.ts drizzle.config.ts eslint.config.js prettier.config.js package.json tsconfig.json pnpm-workspace.yaml",
		"test:unit": "vitest run --passWithNoTests",
		"test": "pnpm test:unit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@lucide/svelte": "^1.48.0",
		"bits-ui": "^2.19.3",
		"drizzle-orm": "^0.45.3",
		"postgres": "^3.4.9"
	}
}
